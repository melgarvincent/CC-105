{
  "rules": {

    "users": {
      "$uid": {
        ".read":
          "auth != null && auth.uid === $uid",

        ".write":
          "auth != null && auth.uid === $uid"
      }
    },

    "bakeryProducts": {
      ".read":
        "auth != null && auth.token.otpVerified === true",

      ".write":
        "auth != null && auth.token.otpVerified === true"
    },

    "activityLogs": {
      ".read":
        "auth != null && auth.token.otpVerified === true",

      ".write":
        "auth != null && auth.token.otpVerified === true"
    },

    "otpChallenges": {
      ".read": false,
      ".write": false
    }

  }
}
